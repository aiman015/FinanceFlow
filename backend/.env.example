# Server
PORT=5000
NODE_ENV=development

# MongoDB — use a local instance or a free MongoDB Atlas cluster
MONGO_URI=mongodb://127.0.0.1:27017/financeflow

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - your frontend's URL(s), comma separated
CLIENT_ORIGIN=http://localhost:5173
